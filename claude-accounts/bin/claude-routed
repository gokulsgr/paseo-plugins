#!/bin/bash
# `claude` for the account picked with claude-accounts. An explicit CLAUDE_CONFIG_DIR wins, and
# Orca's terminals keep Orca's own account routing.
if [ -z "${CLAUDE_CONFIG_DIR:-}" ] && [ -z "${ORCA_TERMINAL_HANDLE:-}" ]; then
    dir=$(cat "$HOME/.claude-accounts/active-dir" 2>/dev/null || true)
    [ -n "$dir" ] && export CLAUDE_CONFIG_DIR="$dir"
fi
bin="$HOME/.local/bin/claude"
[ -x "$bin" ] || bin=$(PATH="${PATH//$HOME\/.local\/share\/claude-accounts\/bin:/}" command -v claude)
exec "$bin" "$@"
